---
import Layout from '../../layouts/Layout.astro';
import PageContainer from '../../components/layout/PageContainer.astro';
import CategoryBadge from '../../components/blog/CategoryBadge.astro';
import { BLOG_POSTS } from '../../data/blog-posts';

export async function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const SITE_URL = 'https://www.calcvantage.com';

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr + 'T00:00:00');
  return new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' }).format(d);
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  author: { '@type': 'Organization', name: 'CalcVantage' },
  publisher: {
    '@type': 'Organization',
    name: 'CalcVantage',
    url: SITE_URL,
  },
  datePublished: post.pubDate,
  url: `${SITE_URL}/blog/${post.slug}`,
  mainEntityOfPage: `${SITE_URL}/blog/${post.slug}`,
};

const schemas = [articleSchema];

if (post.faqs && post.faqs.length > 0) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: post.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  } as Record<string, unknown>);
}
---

<Layout
  title={post.seo?.title || `${post.title} | CalcVantage`}
  description={post.seo?.description || post.excerpt}
  canonical={post.seo?.canonical || `${SITE_URL}/blog/${post.slug}`}
  structuredData={schemas}
>
  <PageContainer maxWidth="md">
    <article class="blog-article">
      <header class="blog-article-header">
        <div class="blog-article-meta">
          <CategoryBadge category={post.category} />
          <span class="blog-article-date font-mono">{formatDate(post.pubDate)}</span>
          <span class="blog-article-sep">·</span>
          <span class="blog-article-reading font-mono">{post.readingTime} min read</span>
        </div>
        <h1 class="blog-article-title">{post.title}</h1>
        {post.subtitle && <p class="blog-article-subtitle">{post.subtitle}</p>}
        <p class="blog-article-author">By {post.author}</p>
      </header>

      <div class="blog-article-content" set:html={post.content} />

      {post.faqs && post.faqs.length > 0 && (
        <section class="blog-article-faq">
          <h2>Frequently Asked Questions</h2>
          {post.faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <div class="faq-answer" set:html={faq.answer} />
            </details>
          ))}
        </section>
      )}

      <footer class="blog-article-footer">
        <div class="blog-article-disclaimer" role="note">
          <span class="blog-article-disclaimer-title font-mono">Disclaimer</span>
          <p>
            CalcVantage provides educational content and calculator estimates for informational purposes only.
            This article should not be considered financial advice. Before making financial decisions,
            consult a licensed professional. For details, review our
            <a href="/disclaimer">Disclaimer</a> and <a href="/terms">Terms of Service</a>.
          </p>
        </div>

        <div class="blog-article-cta">
          <p>Explore our <a href="/mortgage">Mortgage Calculator</a> to estimate your own monthly payments and amortization schedule.</p>
        </div>
      </footer>
    </article>
  </PageContainer>
</Layout>

<style>
  .blog-article {
    padding: 2rem 0 3rem;
  }

  .blog-article-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .blog-article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-article-date,
  .blog-article-reading {
    font-size: 0.8125rem;
    color: var(--color-mute);
  }

  .blog-article-sep {
    color: var(--color-hairline-strong);
  }

  .blog-article-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--color-ink);
    margin: 0;
  }

  .blog-article-subtitle {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-body);
    margin: 0;
  }

  .blog-article-author {
    font-size: 0.875rem;
    color: var(--color-mute);
    margin: 0;
  }

  .blog-article-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 48rem;
  }

  .blog-article-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 2rem 0 0.5rem;
  }

  .blog-article-content :global(h3) {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 1.5rem 0 0.375rem;
  }

  .blog-article-content :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-body);
  }

  .blog-article-content :global(ul),
  .blog-article-content :global(ol) {
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .blog-article-content :global(li) {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-body);
  }

  .blog-article-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  .blog-article-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-article-content :global(a:hover) {
    color: var(--color-accent-deep);
  }

  .blog-article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin: 0.5rem 0;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .blog-article-content :global(th) {
    padding: 0.75rem 1rem;
    background-color: var(--color-canvas-soft-2);
    font-weight: 600;
    color: var(--color-ink);
    text-align: left;
    border-bottom: 1px solid var(--color-hairline);
    white-space: nowrap;
  }

  .blog-article-content :global(td) {
    padding: 0.625rem 1rem;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-body);
  }

  .blog-article-content :global(tbody tr:last-child td) {
    border-bottom: none;
  }

  .blog-article-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: var(--color-canvas-soft);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-xs);
    border: 1px solid var(--color-hairline);
  }

  .blog-article-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.75rem 1.25rem;
    margin: 0.5rem 0;
    background-color: var(--color-canvas-soft);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .blog-article-content :global(blockquote p) {
    color: var(--color-ink);
    font-style: italic;
  }

  /* Responsive Diagram Cards */
  .blog-article-content :global(.diagram-card) {
    margin: 1.5rem 0;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .blog-article-content :global(.diagram-header) {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .blog-article-content :global(.diagram-badge) {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .blog-article-content :global(.diagram-title) {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
  }

  /* PITI Diagram */
  .blog-article-content :global(.piti-diagram-grid) {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 1rem;
  }

  .blog-article-content :global(.piti-plus-divider) {
    font-size: 1.75rem;
    font-weight: 300;
    color: var(--color-mute);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .blog-article-content :global(.piti-group-card) {
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
  }

  .blog-article-content :global(.piti-core) {
    border-left: 3px solid var(--color-accent);
  }

  .blog-article-content :global(.piti-escrow) {
    border-left: 3px solid var(--color-success);
  }

  .blog-article-content :global(.piti-group-header) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .blog-article-content :global(.piti-group-tag) {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mute);
  }

  .blog-article-content :global(.piti-group-formula) {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  .blog-article-content :global(.piti-group-desc) {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-body);
    margin: 0;
  }

  .blog-article-content :global(.piti-items) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-hairline);
  }

  .blog-article-content :global(.piti-item) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .blog-article-content :global(.piti-item strong) {
    font-size: 0.8125rem;
    color: var(--color-ink);
  }

  .blog-article-content :global(.piti-item span) {
    font-size: 0.75rem;
    color: var(--color-body);
    line-height: 1.4;
  }

  /* Escrow Flow Diagram */
  .blog-article-content :global(.escrow-flow-container) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
  }

  .blog-article-content :global(.flow-source) {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .blog-article-content :global(.flow-pill) {
    padding: 0.625rem 1.25rem;
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-full);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.125rem;
    box-shadow: var(--shadow-sm);
  }

  .blog-article-content :global(.flow-pill-label) {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mute);
  }

  .blog-article-content :global(.flow-pill strong) {
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .blog-article-content :global(.flow-line-down) {
    width: 2px;
    height: 1.25rem;
    background-color: var(--color-hairline-strong);
    margin-top: 0.25rem;
  }

  .blog-article-content :global(.flow-branches) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
  }

  .blog-article-content :global(.flow-branch) {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .blog-article-content :global(.flow-card) {
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 1rem 1.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    border-top: 3px solid var(--color-accent);
  }

  .blog-article-content :global(.flow-card-escrow) {
    border-top: 3px solid var(--color-warning);
  }

  .blog-article-content :global(.flow-card-header) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .blog-article-content :global(.flow-card-tag) {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-mute);
  }

  .blog-article-content :global(.flow-card-header strong) {
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .blog-article-content :global(.flow-card-dest) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-body);
    background-color: var(--color-canvas);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-hairline);
  }

  .blog-article-content :global(.flow-arrow) {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  .blog-article-content :global(.flow-subdisbursements) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-hairline-strong);
  }

  .blog-article-content :global(.flow-sub-item) {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-body);
  }

  .blog-article-content :global(.flow-sub-arrow) {
    color: var(--color-warning);
    font-weight: 700;
    flex-shrink: 0;
  }

  .blog-article-content :global(.flow-sub-item strong) {
    color: var(--color-ink);
    display: block;
    font-size: 0.8125rem;
  }

  .blog-article-content :global(.flow-sub-item span) {
    font-size: 0.75rem;
    color: var(--color-mute);
  }

  @media (max-width: 640px) {
    .blog-article-content :global(.piti-diagram-grid) {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .blog-article-content :global(.piti-plus-divider) {
      transform: rotate(90deg);
      height: 1.5rem;
    }

    .blog-article-content :global(.flow-branches) {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .blog-article-content :global(.diagram-card) {
      padding: 1rem;
    }
  }

  /* FAQ Section */
  .blog-article-faq {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .blog-article-faq h2 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
  }

  .faq-item {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas);
    overflow: hidden;
  }

  .faq-question {
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--color-mute);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  details[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding: 0 1.25rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-body);
  }

  .faq-answer :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Footer */
  .blog-article-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-article-disclaimer {
    padding: 1.25rem 1.5rem;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-left: 3px solid var(--color-warning);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 48rem;
  }

  .blog-article-disclaimer-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .blog-article-disclaimer p {
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--color-body);
    margin: 0;
  }

  .blog-article-disclaimer a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-article-cta {
    padding: 1.25rem 1.5rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    max-width: 48rem;
  }

  .blog-article-cta p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-body);
    margin: 0;
  }

  .blog-article-cta a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }

  .blog-article-cta a:hover {
    color: var(--color-accent-deep);
  }

  @media (max-width: 640px) {
    .blog-article {
      padding: 1.5rem 0 2rem;
    }

    .blog-article-content :global(th),
    .blog-article-content :global(td) {
      padding: 0.5rem 0.75rem;
    }

    .blog-article-disclaimer,
    .blog-article-cta {
      padding: 1rem;
    }
  }
</style>
