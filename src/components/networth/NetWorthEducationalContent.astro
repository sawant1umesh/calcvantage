    overflow-x: auto;
  }

  .nec-timeline-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .nec-timeline-table th {
    padding: 0.75rem 1.25rem;
    background-color: var(--color-canvas-soft-2);
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-hairline);
    white-space: nowrap;
  }

  .nec-timeline-table td {
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-body);
    white-space: nowrap;
  }

  .nec-timeline-table tbody tr.row-total td {
    background-color: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline-strong);
    color: var(--color-ink);
  }

  .nec-timeline-table tbody tr.row-networth td {
    background-color: var(--color-accent-soft);
    border-top: 2px solid var(--color-accent);
    color: var(--color-ink);
    font-weight: 700;
  }

  .text-asset {
    color: var(--color-success);
  }

  .text-liability {
    color: #e11d48;
  }

  .text-net {
    color: var(--color-accent-deep);
  }

  /* ── Disclaimer ── */
  .nec-disclaimer {
    padding: 1.25rem 1.5rem;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-left: 3px solid var(--color-warning);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 54rem;
  }

  .nec-disclaimer-title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink);
  }

  .nec-disclaimer p {
