---
import type { FaqItem } from '../../types/faq';

interface Props {
  items: FaqItem[];
  group: string;
  allowMultiple?: boolean;
}

const { items, group, allowMultiple = false } = Astro.props;
---

<div class="faq-accordion" data-faq-group data-allow-multiple={allowMultiple ? 'true' : 'false'}>
  {items.map((item, index) => {
    const open = index === 0;
    const buttonId = `${group}-q-${item.id}`;
    const panelId = `${group}-p-${item.id}`;
    return (
      <div class={`faq-item ${open ? 'is-open' : ''}`} data-faq-item>
        <h3 class="faq-heading">
          <button
            type="button"
            class="faq-trigger"
            id={buttonId}
            aria-expanded={open ? 'true' : 'false'}
            aria-controls={panelId}
            data-faq-trigger
          >
            <span class="faq-question">{item.question}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M5 7.5L10 12.5L15 7.5"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>
        </h3>
        <div
          class="faq-panel"
          id={panelId}
          role="region"
          aria-labelledby={buttonId}
          data-faq-panel
        >
          <div class="faq-panel-inner">
            <p class="faq-answer" set:html={item.answer} />
          </div>
        </div>
      </div>
    );
  })}
</div>

<script>
  declare global {
    interface Window {
      __calcvantageFaq?: boolean;
    }
  }

  const documentElement = document.documentElement;
  documentElement.classList.add('faq-js');

  const openClose = (item: HTMLElement, open: boolean) => {
    const trigger = item.querySelector<HTMLElement>('[data-faq-trigger]');
    if (!trigger) return;
    item.classList.toggle('is-open', open);
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  };

  const closeSiblings = (item: HTMLElement, multiple: boolean) => {
    const group = item.closest<HTMLElement>('[data-faq-group]');
    if (!group || multiple) return;
    group.querySelectorAll<HTMLElement>('[data-faq-item]').forEach((sibling) => {
      if (sibling !== item) openClose(sibling, false);
    });
  };

  const handleClick = (event: MouseEvent) => {
    const target = event.target as HTMLElement | null;
    const trigger = target?.closest<HTMLElement>('[data-faq-trigger]');
    if (!trigger) return;
    const item = trigger.closest<HTMLElement>('[data-faq-item]');
    if (!item) return;
    const group = item.closest<HTMLElement>('[data-faq-group]');
    const multiple = group?.getAttribute('data-allow-multiple') === 'true';
    const willOpen = trigger.getAttribute('aria-expanded') !== 'true';
    if (willOpen) closeSiblings(item, multiple);
    openClose(item, willOpen);
  };

  const handleKeydown = (event: KeyboardEvent) => {
    const target = event.target as HTMLElement | null;
    const trigger = target?.closest<HTMLElement>('[data-faq-trigger]');
    if (!trigger) return;
    const group = trigger.closest<HTMLElement>('[data-faq-group]');
    if (!group) return;
    const triggers = Array.from(group.querySelectorAll<HTMLElement>('[data-faq-trigger]'));
    const index = triggers.indexOf(trigger);
    if (index === -1) return;

    let next: HTMLElement | null = null;
    switch (event.key) {
      case 'ArrowDown':
        next = triggers[(index + 1) % triggers.length];
        break;
      case 'ArrowUp':
        next = triggers[(index - 1 + triggers.length) % triggers.length];
        break;
      case 'Home':
        next = triggers[0];
        break;
      case 'End':
        next = triggers[triggers.length - 1];
        break;
    }

    if (next) {
      event.preventDefault();
      next.focus();
    }
  };

  if (!window.__calcvantageFaq) {
    window.__calcvantageFaq = true;
    document.addEventListener('click', handleClick);
    document.addEventListener('keydown', handleKeydown);
  }
</script>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .faq-item.is-open {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-md);
  }

  .faq-heading {
    margin: 0;
  }

  .faq-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 3.5rem;
    padding: 1rem 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: left;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    -webkit-tap-highlight-color: transparent;
    transition: color var(--transition-fast);
  }

  .faq-trigger:hover {
    color: var(--color-accent-deep);
  }

  .faq-trigger:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus) inset;
  }

  .faq-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    color: var(--color-mute);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    transition: transform var(--transition-normal), color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .faq-icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .faq-item.is-open .faq-icon {
    transform: rotate(180deg);
    color: var(--color-on-primary);
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .faq-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows var(--transition-normal);
  }

  .faq-js .faq-panel {
    grid-template-rows: 0fr;
  }

  .faq-js .faq-item.is-open .faq-panel {
    grid-template-rows: 1fr;
  }

  .faq-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq-answer {
    margin: 0;
    padding: 0 1.25rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-body);
  }

  .faq-answer a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .faq-answer a:hover {
    color: var(--color-accent-deep);
    text-decoration: underline;
  }
</style>