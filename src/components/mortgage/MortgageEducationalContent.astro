    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-body);
    line-height: 1.5;
  }

  .mec-data-table tbody tr:last-child td {
    border-bottom: none;
  }

  /* ── Formula Cards ── */
  .mec-formula-card {
    padding: 1.25rem 1.5rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }

  .mec-formula-badge {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .mec-formula-math {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink);
    padding: 0.5rem 0;
    overflow-x: auto;
  }

  .mec-formula-caption {
    font-size: 0.8125rem;
    color: var(--color-mute);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Example Card & Table ── */
  .mec-example-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    margin: 0.5rem 0;
  }

  .mec-example-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    background-color: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-hairline);
  }

  .mec-example-tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .mec-example-note {
    font-size: 0.75rem;
    color: var(--color-mute);
  }

  .mec-example-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  @media (min-width: 640px) {
    .mec-example-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .mec-example-param {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mec-param-label {
    font-size: 0.75rem;
    color: var(--color-mute);
  }

  .mec-param-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .mec-param-value.highlight {
    color: var(--color-accent);
  }

  .mec-timeline-table-wrap {
    overflow-x: auto;
  }

  .mec-timeline-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .mec-timeline-table th {
    padding: 0.75rem 1.25rem;
    background-color: var(--color-canvas-soft-2);
    font-weight: 600;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-hairline);
