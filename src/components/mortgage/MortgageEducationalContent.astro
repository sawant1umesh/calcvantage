  }

  /* ── Country Comparison Grid ── */
  .mec-country-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0.5rem 0;
  }

  @media (min-width: 768px) {
    .mec-country-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

