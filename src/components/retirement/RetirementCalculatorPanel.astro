---
import Card from '../base/Card.astro';
import Input from '../base/Input.astro';
import Select from '../base/Select.astro';
import Button from '../base/Button.astro';
import { COUNTRIES } from '../../config/countries/index';
import { CURRENCIES } from '../../config/currencies';
import { RETIREMENT_DEFAULTS } from '../../config/retirement/index';

const defaultCountry = 'US';
const defaults = RETIREMENT_DEFAULTS[defaultCountry];

const countryOptions = COUNTRIES.map((c) => ({
  value: c.code,
  label: `${c.flag} ${c.name}`,
}));

const currencyOptions = CURRENCIES.map((c) => ({
  value: c.code,
  label: `${c.code} · ${c.name}`,
}));
---

<Card variant="default" padding="xl" rounded="xl" class="retirement-calculator-panel">
  <div class="panel-header">
    <div class="header-title-group">
      <h2 class="text-display-md">Retirement Parameters</h2>
      <p class="text-body-sm">Project your retirement savings growth and contributions.</p>
    </div>
    <span class="arch-badge" id="ret-country-badge">🇺🇸 US</span>
  </div>

  <form class="retirement-form" id="retirement-form" onsubmit="return false;">
    <!-- Country Selector -->
    <div class="form-section">
      <Select
        id="ret-country-select"
        label="Target Country / Region"
        value={defaultCountry}
        options={countryOptions}
        helperText="Select country for currency display conventions."
      />
    </div>

    <!-- Display Currency Selector (Phase 4B) -->
    <div class="form-section">
      <Select
        id="ret-display-currency-select"
        label="Display Currency"
        value="USD"
        options={currencyOptions}
        helperText="Projections are calculated with the country's native rules; results are displayed in this currency."
      />
      <div class="currency-status-row" id="ret-currency-status" hidden>
        <span class="currency-spinner" id="ret-currency-spinner"></span>
        <span class="currency-status-message" id="ret-currency-message"></span>
      </div>
    </div>

    <!-- Age Group -->
    <div class="form-row two-col">
      <Input
        id="ret-current-age"
        label="Current Age"
        type="number"
        value={defaults.currentAge}
        min={18}
        max={100}
        step={1}
        helperText="Your age today"
        required={true}
      />
      <Input
        id="ret-retirement-age"
        label="Retirement Age"
        type="number"
        value={defaults.retirementAge}
        min={50}
        max={100}
        step={1}
        helperText="Target age to retire"
        required={true}
      />
    </div>

    <!-- Savings & Contribution Group -->
    <div class="form-row two-col">
      <Input
        id="ret-current-savings"
        label="Current Retirement Savings"
        type="number"
        prefix="$"
        value={defaults.currentSavings}
        min={0}
        step={5000}
        helperText="Existing nest egg balance"
        required={true}
      />
      <Input
        id="ret-monthly-contribution"
        label="Monthly Contribution"
        type="number"
        prefix="$"
        value={defaults.monthlyContribution}
        min={0}
        step={50}
        helperText="Amount you add every month"
        required={true}
      />
    </div>

    <!-- Return & Inflation Group -->
    <div class="form-row two-col">
      <Input
        id="ret-expected-return"
        label="Expected Annual Return"
        type="number"
        suffix="%"
        value={defaults.expectedReturnRate}
        min={0}
        max={30}
        step={0.25}
        helperText="Average annual investment return"
        required={true}
      />
      <Input
        id="ret-inflation-rate"
        label="Inflation Rate"
        type="number"
        suffix="%"
        value={defaults.inflationRate}
        min={0}
        max={20}
        step={0.25}
        helperText="Expected long-term inflation"
        required={true}
      />
    </div>

    <!-- Retirement Income Goal -->
    <div class="form-section">
      <Input
        id="ret-income-goal"
        label="Retirement Income Goal (monthly)"
        type="number"
        prefix="$"
        value={defaults.retirementIncomeGoal}
        min={0}
        step={100}
        helperText="Monthly income you want in retirement"
      />
    </div>

    <!-- Action Buttons -->
    <div class="form-actions">
      <Button variant="outline" size="md" type="reset" id="ret-reset-btn">
        Reset to Country Defaults
      </Button>
    </div>
  </form>
</Card>

<style>
  .retirement-calculator-panel {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .header-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .arch-badge {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    color: var(--color-body);
    white-space: nowrap;
  }

  .retirement-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-section {
    width: 100%;
  }

  .currency-status-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-mute);
  }

  .currency-status-row[hidden] {
    display: none;
  }

  .currency-spinner {
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--color-hairline);
    border-top-color: var(--color-accent);
    border-radius: var(--radius-full);
    animation: currency-spin 0.7s linear infinite;
  }

  @keyframes currency-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .form-row.two-col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .form-row.two-col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
  }
</style>

<script>
  import { COUNTRIES } from '../../config/countries/index';
  import { RETIREMENT_DEFAULTS } from '../../config/retirement/index';
  import { retirementService } from '../../services/retirement/retirement.service';
  import {
    getConversionContext,
    getCurrencySymbol,
    getNativeCurrency,
    loadDisplayCurrency,
    saveDisplayCurrency,
    subscribeCurrencyStatus,
  } from '../../utils/currency-display';
  import type { CountryCode } from '../../types/country';
  import type { CurrencyCode } from '../../types/currency';
  import type { RetirementResults } from '../../types/retirement';

  document.addEventListener('DOMContentLoaded', () => {
    // Input elements
    const countrySelect = document.getElementById('ret-country-select') as HTMLSelectElement | null;
    const currentAgeInput = document.getElementById('ret-current-age') as HTMLInputElement | null;
    const retirementAgeInput = document.getElementById('ret-retirement-age') as HTMLInputElement | null;
    const currentSavingsInput = document.getElementById('ret-current-savings') as HTMLInputElement | null;
    const monthlyContributionInput = document.getElementById('ret-monthly-contribution') as HTMLInputElement | null;
    const expectedReturnInput = document.getElementById('ret-expected-return') as HTMLInputElement | null;
    const inflationRateInput = document.getElementById('ret-inflation-rate') as HTMLInputElement | null;
    const incomeGoalInput = document.getElementById('ret-income-goal') as HTMLInputElement | null;
    const resetBtn = document.getElementById('ret-reset-btn') as HTMLButtonElement | null;

    // Phase 4B: Display currency selector + status indicator
    const displayCurrencySelect = document.getElementById('ret-display-currency-select') as HTMLSelectElement | null;
    const currencyStatus = document.getElementById('ret-currency-status');
    const currencySpinner = document.getElementById('ret-currency-spinner');
    const currencyStatusMessage = document.getElementById('ret-currency-message');

    // Badge / note elements
    const countryBadge = document.getElementById('ret-country-badge');
    const countryNote = document.getElementById('ret-country-note');
    const summaryText = document.getElementById('ret-summary-text');

    // Result card elements (in RetirementResultsPanel)
    const futureCard = document.querySelector('.ret-future-card .result-value');
    const futureCurr = document.querySelector('.ret-future-card .result-currency');
    const inflatedCard = document.querySelector('.ret-inflated-card .result-value');
    const inflatedCurr = document.querySelector('.ret-inflated-card .result-currency');
    const incomeCard = document.querySelector('.ret-income-card .result-value');
    const incomeCurr = document.querySelector('.ret-income-card .result-currency');
    const contribCard = document.querySelector('.ret-contrib-card .result-value');
    const contribCurr = document.querySelector('.ret-contrib-card .result-currency');
    const growthCard = document.querySelector('.ret-growth-card .result-value');
    const growthCurr = document.querySelector('.ret-growth-card .result-currency');
    const yearsCard = document.querySelector('.ret-years-card .result-value');
    const goaltargetCard = document.querySelector('.ret-goaltarget-card .result-value');
    const goaltargetCurr = document.querySelector('.ret-goaltarget-card .result-currency');
    const goaltargetSubtext = document.querySelector('.ret-goaltarget-card .result-subtext');

    // Readiness + goal achievement elements
    const readinessBanner = document.getElementById('ret-readiness-banner');
    const readinessLabel = document.getElementById('ret-readiness-label');
    const readinessNote = document.getElementById('ret-readiness-note');
    const goalPercent = document.getElementById('ret-goal-percent');
    const goalProgress = document.getElementById('ret-goal-progress');
    const goalTarget = document.getElementById('ret-goal-target');
    const goalCaption = document.getElementById('ret-goal-caption');

    // Warnings box
    const warningsBox = document.getElementById('ret-warnings-box');
    const warningsList = document.getElementById('ret-warnings-list');

    if (
      !countrySelect || !currentAgeInput || !retirementAgeInput ||
      !currentSavingsInput || !monthlyContributionInput || !expectedReturnInput ||
      !inflationRateInput || !incomeGoalInput
    ) {
      return;
    }

    const formatNum = (val: number) => new Intl.NumberFormat('en-US').format(Math.round(val));

    // Phase 4B: shared currency conversion state
    let displayCurrency: CurrencyCode = 'USD';
    let nativeCurrency: CurrencyCode = 'USD';
    let convRate = 1;
    let convSource: 'live' | 'cache' | 'fallback' = 'live';
    let sameCurrency = true;
    let renderToken = 0;
    let lastResults: RetirementResults | null = null;
    let lastIncomeGoal = 0;

    // Phase 4B helpers
    const applyRate = (val: number) =>
      sameCurrency || convSource === 'fallback' ? val : Math.round(val * convRate);

    const showCurrencyStatus = (msg: string, spinner = false) => {
      if (!currencyStatus) return;
      currencyStatus.hidden = false;
      if (currencySpinner) currencySpinner.style.display = spinner ? 'inline-block' : 'none';
      if (currencyStatusMessage) currencyStatusMessage.textContent = msg;
    };

    const hideCurrencyStatus = () => {
      if (currencyStatus) currencyStatus.hidden = true;
    };

    const applyCountryDefaults = (countryCode: CountryCode) => {
      const defaults = RETIREMENT_DEFAULTS[countryCode] || RETIREMENT_DEFAULTS['US'];
      currentAgeInput.value = String(defaults.currentAge);
      retirementAgeInput.value = String(defaults.retirementAge);
      currentSavingsInput.value = String(defaults.currentSavings);
      monthlyContributionInput.value = String(defaults.monthlyContribution);
      expectedReturnInput.value = String(defaults.expectedReturnRate);
      inflationRateInput.value = String(defaults.inflationRate);
      incomeGoalInput.value = String(defaults.retirementIncomeGoal);
    };

    const updateCalculator = () => {
      const countryCode = (countrySelect.value as CountryCode) || 'US';

      const currentAge = parseFloat(currentAgeInput.value) || 0;
      const retirementAge = parseFloat(retirementAgeInput.value) || 0;
      const currentSavings = parseFloat(currentSavingsInput.value) || 0;
      const monthlyContribution = parseFloat(monthlyContributionInput.value) || 0;
      const expectedReturnRate = parseFloat(expectedReturnInput.value) || 0;
      const inflationRate = parseFloat(inflationRateInput.value) || 0;
      const retirementIncomeGoal = parseFloat(incomeGoalInput.value) || 0;

      // Badge & note text
      const countryObj = COUNTRIES.find((c) => c.code === countryCode);
      if (countryBadge && countryObj) {
        countryBadge.textContent = `${countryObj.flag} ${countryObj.code}`;
      }
      if (countryNote && countryObj) {
        countryNote.textContent = `Projection based on ${countryObj.name} (${countryObj.currencyCode}) assumptions`;
      }

      // Invoke Retirement Service
      const results = retirementService.calculate({
        country: countryCode,
        currentAge,
        retirementAge,
        currentSavings,
        monthlyContribution,
        expectedReturnRate,
        inflationRate,
        retirementIncomeGoal,
      });

      // Update result cards
      if (summaryText) {
        summaryText.textContent =
          results.yearsUntilRetirement > 0
            ? `Saving for ${results.yearsUntilRetirement} years until age ${retirementAge}.`
            : 'Enter a retirement age later than your current age.';
      }

      // Phase 4B: Store native results and render them in the selected display currency
      lastResults = results;
      lastIncomeGoal = retirementIncomeGoal;
      renderDisplay();
      if (goalPercent) {
        goalPercent.textContent = results.goalAchievementPercent === null ? '--%' : `${results.goalAchievementPercent}%`;
      }
      if (goalProgress && goalProgress.parentElement) {
        const pct = Math.min(100, results.goalAchievementPercent ?? 0);
        goalProgress.style.width = `${pct}%`;
        goalProgress.classList.remove('is-complete', 'is-fair', 'is-low');
        if (results.goalAchievementPercent === null) {
          goalProgress.classList.remove('is-fair', 'is-low', 'is-complete');
        } else if (pct >= 100) {
          goalProgress.classList.add('is-complete');
        } else if (pct < 60) {
          goalProgress.classList.add('is-low');
        } else if (pct < 80) {
          goalProgress.classList.add('is-fair');
        }
      }

      // Readiness banner
      if (readinessBanner && readinessLabel && readinessNote) {
        const readinessClassMap: Record<string, string> = {
          'Excellent': 'readiness-excellent',
          'Good': 'readiness-good',
          'Fair': 'readiness-fair',
          'Needs Improvement': 'readiness-needs-improvement',
        };
        readinessBanner.className = `readiness-banner ${readinessClassMap[results.readiness] || 'readiness-needs-improvement'}`;
        readinessLabel.textContent = results.readiness;
        readinessNote.textContent = results.readinessNote;
      }

      // Render warnings if any
      if (warningsBox && warningsList) {
        if (results.warnings && results.warnings.length > 0) {
          warningsBox.style.display = 'flex';
          warningsList.innerHTML = results.warnings
            .map((w) => `<li class="text-caption">${w}</li>`)
            .join('');
        } else {
          warningsBox.style.display = 'none';
          warningsList.innerHTML = '';
        }
      }

      // Inline validation errors
      renderValidationErrors(
        currentAge,
        retirementAge,
        currentSavings,
        monthlyContribution,
        expectedReturnRate,
        inflationRate,
        retirementIncomeGoal
      );
    };

    // Phase 4B: Convert native-currency results into the selected display currency
    const renderDisplay = async () => {
      const token = ++renderToken;
      nativeCurrency = getNativeCurrency((countrySelect.value as CountryCode) || 'US');
      const ctx = await getConversionContext(nativeCurrency, displayCurrency);
      if (token !== renderToken) return;

      convRate = ctx.rate;
      convSource = ctx.source;
      sameCurrency = ctx.isSameCurrency;

      const symbol = getCurrencySymbol(displayCurrency);

      if (futureCurr) futureCurr.textContent = symbol;
      if (inflatedCurr) inflatedCurr.textContent = symbol;
      if (incomeCurr) incomeCurr.textContent = symbol;
      if (contribCurr) contribCurr.textContent = symbol;
      if (growthCurr) growthCurr.textContent = symbol;
      if (goaltargetCurr) goaltargetCurr.textContent = symbol;

      if (!lastResults) return;

      const r = lastResults;
      if (futureCard) futureCard.textContent = formatNum(applyRate(r.futureRetirementValue));
      if (inflatedCard) inflatedCard.textContent = formatNum(applyRate(r.inflationAdjustedRetirementValue));
      if (incomeCard) incomeCard.textContent = formatNum(applyRate(r.estimatedMonthlyIncome));
      if (contribCard) contribCard.textContent = formatNum(applyRate(r.totalContributions));
      if (growthCard) growthCard.textContent = formatNum(applyRate(r.investmentGrowth));
      if (yearsCard) yearsCard.textContent = String(r.yearsUntilRetirement);
      if (goaltargetCard) goaltargetCard.textContent = formatNum(applyRate(r.inflationAdjustedMonthlyGoal));
      if (goalTarget) goalTarget.textContent = `Monthly goal ${symbol}${formatNum(applyRate(lastIncomeGoal))}`;

      // Currency status messaging
      if (ctx.isSameCurrency) {
        hideCurrencyStatus();
      } else if (ctx.source === 'fallback') {
        showCurrencyStatus(`Live exchange rates are unavailable right now — showing original ${ctx.native} values.`);
      } else if (ctx.source === 'cache') {
        showCurrencyStatus('Live exchange rates unavailable — showing last cached rates.');
      } else {
        hideCurrencyStatus();
      }
    };

    const renderValidationErrors = (
      currentAge: number,
      retirementAge: number,
      currentSavings: number,
      monthlyContribution: number,
      expectedReturnRate: number,
      inflationRate: number,
      retirementIncomeGoal: number
    ) => {
      toggleFieldError(currentAgeInput, currentAge < 18 ? 'Current age must be at least 18.' : currentAge > 100 ? 'Current age cannot exceed 100.' : undefined);
      toggleFieldError(retirementAgeInput, retirementAge <= currentAge ? 'Retirement age must be greater than current age.' : retirementAge > 100 ? 'Retirement age cannot exceed 100.' : undefined);
      toggleFieldError(currentSavingsInput, currentSavings < 0 ? 'Current savings cannot be negative.' : undefined);
      toggleFieldError(monthlyContributionInput, monthlyContribution < 0 ? 'Monthly contribution cannot be negative.' : undefined);
      toggleFieldError(expectedReturnInput, expectedReturnRate < 0 ? 'Expected return cannot be negative.' : expectedReturnRate > 30 ? 'Expected return cannot exceed 30%.' : undefined);
      toggleFieldError(inflationRateInput, inflationRate < 0 ? 'Inflation cannot be negative.' : inflationRate > 20 ? 'Inflation cannot exceed 20%.' : undefined);
      toggleFieldError(incomeGoalInput, retirementIncomeGoal < 0 ? 'Income goal cannot be negative.' : undefined);
    };

    const toggleFieldError = (inputEl: HTMLInputElement | null, errorMsg?: string) => {
      if (!inputEl) return;
      const wrapper = inputEl.closest('.input-wrapper');
      if (!wrapper) return;

      let errorTextEl = wrapper.querySelector('.input-error-text');
      if (errorMsg) {
        wrapper.classList.add('has-error');
        if (!errorTextEl) {
          errorTextEl = document.createElement('p');
          errorTextEl.className = 'input-error-text';
          wrapper.appendChild(errorTextEl);
        }
        errorTextEl.textContent = errorMsg;
      } else {
        wrapper.classList.remove('has-error');
        if (errorTextEl) {
          errorTextEl.remove();
        }
      }
    };

    // Live listeners
    currentAgeInput.addEventListener('input', updateCalculator);
    retirementAgeInput.addEventListener('input', updateCalculator);
    currentSavingsInput.addEventListener('input', updateCalculator);
    monthlyContributionInput.addEventListener('input', updateCalculator);
    expectedReturnInput.addEventListener('input', updateCalculator);
    inflationRateInput.addEventListener('input', updateCalculator);
    incomeGoalInput.addEventListener('input', updateCalculator);

    countrySelect.addEventListener('change', () => {
      const newCountry = countrySelect.value as CountryCode;

      // Phase 4B: auto-set the display currency to the country's native currency
      displayCurrency = getNativeCurrency(newCountry);
      if (displayCurrencySelect) displayCurrencySelect.value = displayCurrency;
      saveDisplayCurrency('retirement', displayCurrency);

      applyCountryDefaults(newCountry);
      updateCalculator();
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        const country = (countrySelect.value as CountryCode) || 'US';
        displayCurrency = getNativeCurrency(country);
        if (displayCurrencySelect) displayCurrencySelect.value = displayCurrency;
        saveDisplayCurrency('retirement', displayCurrency);
        applyCountryDefaults(country);
        updateCalculator();
      });
    }

    // Phase 4B: Wire up the display currency selector and shared-service status indicator
    if (displayCurrencySelect) {
      displayCurrency = getNativeCurrency((countrySelect.value as CountryCode) || 'US');
      displayCurrencySelect.value = displayCurrency;
      saveDisplayCurrency('retirement', displayCurrency);
      displayCurrencySelect.addEventListener('change', () => {
        displayCurrency = displayCurrencySelect.value as CurrencyCode;
        saveDisplayCurrency('retirement', displayCurrency);
        renderDisplay();
      });
    }

    subscribeCurrencyStatus((snap) => {
      if (snap.status === 'loading') {
        showCurrencyStatus('Fetching exchange rates…', true);
      }
    });

    // Initial calculation on page load
    updateCalculator();
  });
</script>