---
import { BLOG_POSTS } from '../../data/blog-posts';

// Pick the three posts most directly tied to the calculators
const FEATURED_SLUGS = [
  'understanding-mortgage-payments',
  'retirement-savings-guide',
  'net-worth-basics',
];

const guidePosts = FEATURED_SLUGS
  .map((slug) => BLOG_POSTS.find((p) => p.slug === slug))
  .filter(Boolean);

const formatDate = (iso: string) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  }).format(new Date(iso));

const calculators = [
  {
    name: 'Mortgage Calculator',
    href: '/mortgage/',
    description:
      'Enter your loan amount, interest rate, and term to estimate your monthly mortgage payment. See how principal, interest, and loan length affect what you pay — and explore the full amortization schedule.',
    cta: 'Open Mortgage Calculator',
    icon: 'mortgage',
  },
  {
    name: 'Retirement Calculator',
    href: '/retirement/',
    description:
      'Project how your current savings and regular contributions could grow over time. Adjust your retirement age, expected return, and inflation assumptions to build a picture of your future retirement savings.',
    cta: 'Open Retirement Calculator',
    icon: 'retirement',
  },
  {
    name: 'Net Worth Calculator',
    href: '/net-worth/',
    description:
      'List your assets and liabilities to calculate your total net worth. Understand your overall financial position and track how it changes as you pay down debt or grow your savings.',
    cta: 'Open Net Worth Calculator',
    icon: 'networth',
  },
];
---

<div class="hsc-wrapper">

  <!-- ─── Section 1: Intro ─── -->
  <section class="hsc-section" aria-labelledby="hsc-intro-heading">
    <header class="hsc-header">
      <span class="hsc-eyebrow font-mono">About CalcVantage</span>
      <h2 class="hsc-title" id="hsc-intro-heading">Financial Calculators for Real-Life Decisions</h2>
    </header>
    <div class="hsc-prose">
      <p>
        CalcVantage provides free financial calculators to help you estimate and understand common
        financial decisions — without an account, without fees, and without sharing your data.
        Whether you are working out a <a href="/mortgage/">mortgage payment</a>, planning your
        <a href="/retirement/">retirement savings</a>, or checking your
        <a href="/net-worth/">net worth</a>, each calculator applies country-specific rules for
        the United States, Canada, and Australia so the numbers reflect your situation.
      </p>
      <p>
        The calculators are built to be transparent. Every input is explained, every result is
        labelled, and the assumptions behind the math are shown — not hidden.
      </p>
    </div>
  </section>

  <!-- ─── Section 2: Why CalcVantage ─── -->
  <section class="hsc-section" aria-labelledby="hsc-why-heading">
    <header class="hsc-header">
      <span class="hsc-eyebrow font-mono">Why CalcVantage</span>
      <h2 class="hsc-title" id="hsc-why-heading">Free Financial Calculators for US, Canada &amp; Australia</h2>
    </header>
    <div class="hsc-prose">
      <p>
        CalcVantage provides free financial calculators designed to help you estimate mortgage
        payments, plan for retirement, and understand your net worth. Our calculators are built
        with clear assumptions and country-specific considerations to help you understand how
        each result is calculated.
      </p>
    </div>
    <ul class="hsc-features">
      <li class="hsc-feature">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
        <span>Free to use</span>
      </li>
      <li class="hsc-feature">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
        <span>No account required</span>
      </li>
      <li class="hsc-feature">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
        <span>Privacy-focused calculations</span>
      </li>
      <li class="hsc-feature">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
        <span>Country-specific options</span>
      </li>
      <li class="hsc-feature">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
        <span>Clear calculation methodology</span>
      </li>
      <li class="hsc-feature">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
        <span>Educational tools, not financial advice</span>
      </li>
    </ul>
  </section>

  <!-- ─── Section 3: How it works ─── -->
  <section class="hsc-section" aria-labelledby="hsc-how-heading">
    <header class="hsc-header">
      <span class="hsc-eyebrow font-mono">How it works</span>
      <h2 class="hsc-title" id="hsc-how-heading">How Our Calculators Work</h2>
    </header>
    <div class="hsc-prose">
      <p>
        You enter relevant financial information — loan amount, interest rate, savings balance,
        asset totals, or other inputs depending on the calculator. Calculations are performed
        using standard financial formulas and assumptions. Country-specific rules are considered
        where applicable, such as Canadian semi-annual compounding or Australian stamp duty.
      </p>
      <p>
        Results are estimates for educational and planning purposes. They should not be
        considered guaranteed financial outcomes. Before relying on a result, review the
        <a href="/methodology/">calculation methodology and assumptions</a> that power each
        calculator.
      </p>
    </div>
  </section>

  <!-- ─── Section 3: Choose a Calculator ─── -->
  <section class="hsc-section" aria-labelledby="hsc-calc-heading">
    <header class="hsc-header">
      <span class="hsc-eyebrow font-mono">Calculator overview</span>
      <h2 class="hsc-title" id="hsc-calc-heading">Choose a Calculator</h2>
    </header>
    <div class="hsc-calc-grid">
      {calculators.map((calc) => (
        <a class="hsc-calc-card" href={calc.href}>
          <div class="hsc-calc-icon" aria-hidden="true">
            {calc.icon === 'mortgage' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
            )}
            {calc.icon === 'retirement' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
                <polyline points="17 6 23 6 23 12" />
              </svg>
            )}
            {calc.icon === 'networth' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                <polyline points="2 17 12 22 22 17" />
                <polyline points="2 12 12 17 22 12" />
              </svg>
            )}
          </div>
          <div class="hsc-calc-body">
            <span class="hsc-calc-name">{calc.name}</span>
            <p class="hsc-calc-desc">{calc.description}</p>
            <span class="hsc-calc-cta">
              {calc.cta}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ─── Section 4: Helpful Financial Guides ─── -->
  {guidePosts.length > 0 && (
    <section class="hsc-section" aria-labelledby="hsc-guides-heading">
      <header class="hsc-header">
        <span class="hsc-eyebrow font-mono">From the blog</span>
        <h2 class="hsc-title" id="hsc-guides-heading">Helpful Financial Guides</h2>
      </header>
      <ul class="hsc-guide-list">
        {guidePosts.map((post) => (
          <li class="hsc-guide-item">
            <a class="hsc-guide-link" href={`/blog/${post!.slug}`}>
              <span class="hsc-guide-title">{post!.title}</span>
              <p class="hsc-guide-excerpt">{post!.excerpt}</p>
              <span class="hsc-guide-meta font-mono">
                {formatDate(post!.pubDate)}&nbsp;&middot;&nbsp;{post!.readingTime}&nbsp;min read
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="hsc-guides-footer">
        <a class="hsc-all-link" href="/blog/">
          View all articles
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </a>
      </div>
    </section>
  )}

  <!-- ─── Disclaimer ─── -->
  <div class="hsc-disclaimer" role="note">
    CalcVantage calculators provide estimates for educational and informational purposes only.
    Results may differ from actual financial outcomes and should not be considered financial advice.
  </div>

</div>

<style>
  /* ── Wrapper ── */
  .hsc-wrapper {
    padding: 2rem 0 3rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Shared section header ── */
  .hsc-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hsc-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 44rem;
  }

  .hsc-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .hsc-title {
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0;
  }

  /* ── Features list ── */
  .hsc-features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 1.5rem;
  }

  .hsc-feature {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-body);
  }

  .hsc-feature svg {
    color: var(--color-success);
    flex-shrink: 0;
  }

  /* ── Prose ── */
  .hsc-prose {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 52rem;
  }

  .hsc-prose p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-body);
    margin: 0;
  }

  .hsc-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hsc-prose a:hover {
    color: var(--color-accent-deep);
  }

  /* ── Calculator cards ── */
  .hsc-calc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .hsc-calc-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hsc-calc-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .hsc-calc-card:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .hsc-calc-card:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
  }

  .hsc-calc-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.375rem;
    height: 2.375rem;
    flex-shrink: 0;
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .hsc-calc-card:hover .hsc-calc-icon {
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-color: var(--color-accent-soft);
  }

  .hsc-calc-body {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    flex: 1;
    min-width: 0;
  }

  .hsc-calc-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .hsc-calc-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-body);
    margin: 0;
    flex: 1;
  }

  .hsc-calc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    transition: gap var(--transition-fast);
  }

  .hsc-calc-card:hover .hsc-calc-cta svg {
    transform: translateX(2px);
    transition: transform var(--transition-fast);
  }

  /* ── Guide list ── */
  .hsc-guide-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hsc-guide-item {
    border-left: 2px solid var(--color-hairline);
    transition: border-color var(--transition-fast);
  }

  .hsc-guide-item:hover {
    border-left-color: var(--color-accent);
  }

  .hsc-guide-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.625rem 1rem;
    text-decoration: none;
  }

  .hsc-guide-title {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition: color var(--transition-fast);
  }

  .hsc-guide-link:hover .hsc-guide-title {
    color: var(--color-accent-deep);
  }

  .hsc-guide-excerpt {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-body);
    margin: 0;
  }

  .hsc-guide-meta {
    font-size: 0.75rem;
    color: var(--color-mute);
    margin-top: 0.125rem;
  }

  .hsc-guides-footer {
    margin-top: 0.5rem;
  }

  .hsc-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .hsc-all-link:hover {
    color: var(--color-accent-deep);
  }

  .hsc-all-link svg {
    transition: transform var(--transition-fast);
  }

  .hsc-all-link:hover svg {
    transform: translateX(2px);
  }

  /* ── Disclaimer ── */
  .hsc-disclaimer {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-mute);
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background-color: var(--color-canvas-soft);
    max-width: 52rem;
  }

  /* ── Mobile tweaks ── */
  @media (max-width: 640px) {
    .hsc-wrapper {
      padding: 1.5rem 0 2rem;
      gap: 2.25rem;
    }

    .hsc-calc-card {
      padding: 1.25rem;
    }
  }
</style>
