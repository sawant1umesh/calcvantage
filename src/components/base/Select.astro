---
import type { SelectProps } from '../../types/components';

interface Props extends SelectProps {}

const {
  id,
  name = id,
  label,
  value,
  options = [],
  helperText,
  error,
  disabled = false,
  required = false,
  class: className = '',
} = Astro.props;
---

<div class={`select-wrapper ${className} ${disabled ? 'is-disabled' : ''} ${error ? 'has-error' : ''}`}>
  {label && (
    <label for={id} class="select-label">
      {label}
      {required && <span class="required-asterisk">*</span>}
    </label>
  )}
  <div class="select-field-container">
    <select
      id={id}
      name={name}
      disabled={disabled}
      required={required}
      class="select-control"
    >
      {options.map((option) => (
        <option
          value={option.value}
          selected={String(option.value) === String(value)}
          disabled={option.disabled}
        >
          {option.label}
        </option>
      ))}
    </select>
    <div class="select-chevron">
      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
  {error ? (
    <p class="select-error-text">{error}</p>
  ) : helperText ? (
    <p class="select-helper-text">{helperText}</p>
  ) : null}
</div>

<style>
  .select-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    width: 100%;
  }

  .select-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .required-asterisk {
    color: var(--color-error);
    margin-left: 0.25rem;
  }

  .select-field-container {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .select-control {
    width: 100%;
    height: 2.75rem;
    padding: 0 2.25rem 0 0.875rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: var(--color-ink);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-sm);
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .select-control:focus {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-focus);
  }

  .select-chevron {
    position: absolute;
    right: 0.875rem;
    pointer-events: none;
    color: var(--color-mute);
    display: flex;
    align-items: center;
  }

  .select-wrapper.has-error .select-control {
    border-color: var(--color-error);
  }

  .select-wrapper.is-disabled .select-control {
    background-color: var(--color-canvas-soft-2);
    cursor: not-allowed;
    opacity: 0.7;
  }

  .select-helper-text {
    font-size: 0.75rem;
    color: var(--color-mute);
    margin: 0;
  }

  .select-error-text {
    font-size: 0.75rem;
    color: var(--color-error);
    margin: 0;
  }
</style>
