---
import type { ResultCardProps } from '../../types/components';

interface Props extends ResultCardProps {}

const {
  label,
  value,
  currencySymbol = '$',
  subtext,
  highlight = false,
  badge,
  class: className = '',
} = Astro.props;
---

<div class={`result-card ${highlight ? 'is-highlighted' : ''} ${className}`}>
  <div class="result-card-header">
    <span class="result-label">{label}</span>
    {badge && <span class="result-badge">{badge}</span>}
  </div>
  <div class="result-value-container">
    <span class="result-currency">{currencySymbol}</span>
    <span class="result-value font-mono">{value}</span>
  </div>
  {subtext && <p class="result-subtext">{subtext}</p>}
</div>

<style>
  .result-card {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .result-card.is-highlighted {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
    padding: 1.5rem 1.5rem 1.625rem;
  }

  .result-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }

  .result-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-body);
  }

  .result-card.is-highlighted .result-label {
    color: rgba(255, 255, 255, 0.75);
  }

  .result-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    background-color: var(--color-canvas-soft-2);
    color: var(--color-ink);
  }

  .result-card.is-highlighted .result-badge {
    background-color: rgba(255, 255, 255, 0.18);
    color: var(--color-on-primary);
  }

  .result-value-container {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    min-width: 0;
  }

  .result-currency {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-mute);
  }

  .result-card.is-highlighted .result-currency {
    color: rgba(255, 255, 255, 0.7);
  }

  .result-value {
    font-size: clamp(1.375rem, 4vw, 1.875rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .result-card.is-highlighted .result-value {
    color: var(--color-on-primary);
  }

  .result-subtext {
    font-size: 0.75rem;
    color: var(--color-mute);
    margin: 0;
    line-height: 1.5;
  }

  .result-card.is-highlighted .result-subtext {
    color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 400px) {
    .result-card {
      padding: 1rem 1.125rem;
    }

    .result-card.is-highlighted {
      padding: 1.25rem 1.125rem;
    }
  }
</style>
