---
import type { SectionProps } from '../../types/components';

interface Props extends SectionProps {}

const { title, subtitle, badge, class: className = '' } = Astro.props;
---

<section class={`section-container ${className}`}>
  {(title || subtitle || badge) && (
    <header class="section-header">
      {badge && <span class="section-badge">{badge}</span>}
      {title && <h2 class="section-title text-display-md">{title}</h2>}
      {subtitle && <p class="section-subtitle text-body-md">{subtitle}</p>}
    </header>
  )}
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .section-container {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .section-header {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ink);
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    margin-bottom: 0.25rem;
  }

  .section-title {
    color: var(--color-ink);
    margin: 0;
  }

  .section-subtitle {
    color: var(--color-body);
    margin: 0;
  }

  .section-content {
    width: 100%;
  }
</style>
