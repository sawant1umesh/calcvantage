---
import PageContainer from '../components/layout/PageContainer.astro';
import Card from '../components/base/Card.astro';
import ButtonLink from '../components/base/ButtonLink.astro';

const calculators = [
  {
    name: 'Mortgage Calculator',
    href: '/mortgage',
    blurb:
      'Estimate your monthly mortgage payment from home value, down payment, interest rate, term, property tax, insurance, and HOA fees.',
    detail: 'Includes CMHC insurance rules for Canada and stamp duty for Australia.',
  },
  {
    name: 'Retirement Calculator',
    href: '/retirement',
    blurb:
      'Project how your savings could grow over time — contributions, investment growth, and your total at retirement.',
    detail: 'Adjust for inflation and see the difference small changes make.',
  },
  {
    name: 'Net Worth Calculator',
    href: '/net-worth',
    blurb:
      'Add up your assets and liabilities to see your full financial picture at a glance.',
    detail: 'Track everything in one place without signing up or installing anything.',
  },
];

const trustPoints = [
  {
    title: 'Accurate formulas',
    copy: 'Every calculator is built on standard financial formulas and validated against known results before it ships.',
  },
  {
    title: 'Country-specific calculations',
    copy: 'Where local rules apply — CMHC insurance in Canada, stamp duty in Australia, property tax in the US — the math reflects the country you pick.',
  },
  {
    title: 'Fast performance',
    copy: 'All calculations run instantly in your browser. No waiting on servers, no spinning wheels between keystrokes.',
  },
  {
    title: 'Privacy-first approach',
    copy: 'You never create an account, and we have nothing to sell. There is no tracking of your financial inputs.',
  },
  {
    title: 'Free to use',
    copy: 'Every calculator is free, with no paywall, no premium tier, and no feature locked behind a subscription.',
  },
  {
    title: 'No account required',
    copy: 'Open the tool you need and start calculating. No email, no password, no onboarding flow.',
  },
];

const principles = [
  {
    title: 'Accuracy',
    copy: 'The numbers have to be right before anything else matters. Formulas are tested, and results are double-checked.',
  },
  {
    title: 'Simplicity',
    copy: 'A calculator should take minutes, not an afternoon. We keep the inputs clear and the output easy to read.',
  },
  {
    title: 'Transparency',
    copy: 'You should always be able to see how a result was reached. If a number comes from a rule, we say which rule and why.',
  },
  {
    title: 'Continuous improvement',
    copy: 'Rates, rules, and life change. We keep updating the tools so they stay useful after the first version.',
  },
];
---

<PageContainer maxWidth="xl">
  <!-- 1. Hero -->
  <section class="about-hero">
    <span class="pill-badge font-mono">About CalcVantage</span>
    <h1 class="about-title">
      Clear numbers,<br />better financial decisions.
    </h1>
    <p class="about-lead">
      CalcVantage is a growing library of free financial calculators built for the real rules of the
      US, Canada, and Australia — fast, accurate, and honest about what each number means.
    </p>
    <div class="about-hero-actions">
      <ButtonLink href="/mortgage" size="lg" variant="primary">Explore the calculators</ButtonLink>
      <ButtonLink href="#offerings" size="lg" variant="secondary">See what we offer</ButtonLink>
    </div>
  </section>

  <!-- 2. Who We Are -->
  <section class="about-block">
    <header class="about-block-header">
      <span class="about-eyebrow font-mono">Who we are</span>
      <h2 class="about-block-title">Fewer empty spreadsheets, more clear answers.</h2>
      <p class="about-block-copy">
        CalcVantage exists because most financial tools are either locked behind signups, buried
        under advertising, or written for people who already know the answer. We wanted something
        different: reliable financial calculators that anyone can pick up and use in minutes.
      </p>
      <p class="about-block-copy">
        We build every tool the way we would want it for ourselves — checked against standard
        financial formulas, respectful of the way money rules actually work, and kept free of
        clutter so the numbers stay the point. From a first mortgage estimate to a retirement
        projection, our goal is to help people make better financial decisions, one clear
        calculation at a time.
      </p>
    </header>
  </section>

  <!-- 3. Our Mission -->
  <section class="about-mission">
    <Card variant="soft" padding="xl" rounded="xl" class="about-mission-card">
      <span class="about-eyebrow font-mono">Our mission</span>
      <h2 class="about-mission-title">
        To help people make informed financial decisions through accurate, easy-to-use calculators.
      </h2>
      <p class="about-block-copy">
        A mortgage, a retirement plan, or a full net-worth statement shouldn&rsquo;t require a
        finance degree to understand. When you can see the numbers clearly — what a payment looks
        like, how savings can grow, where your money stands today — you can decide with confidence.
        That&rsquo;s what we work toward with every tool we release.
      </p>
    </Card>
  </section>

  <!-- 4. What We Offer -->
  <section class="about-block" id="offerings">
    <header class="about-block-header">
      <span class="about-eyebrow font-mono">What we offer</span>
      <h2 class="about-block-title">Three calculators today, more on the way.</h2>
      <p class="about-block-copy">
        Each tool is built to answer one practical question and answer it well. Start with the one
        that matches what you&rsquo;re planning.
      </p>
    </header>

    <div class="offer-grid">
      {
        calculators.map((calc) => (
          <a class="offer-card-link" href={calc.href}>
            <Card variant="default" padding="lg" rounded="lg" class="offer-card">
              <h3 class="offer-name">{calc.name}</h3>
              <p class="offer-blurb">{calc.blurb}</p>
              <p class="offer-detail">{calc.detail}</p>
              <span class="offer-cta">Open calculator →</span>
            </Card>
          </a>
        ))
      }
    </div>

    <p class="about-block-copy about-more-tools">
      These three are the start. More financial tools — refinance planning, affordability checks,
      auto loan estimates, and investment growth projections — are in development and will be added
      to CalcVantage over time.
    </p>
  </section>

  <!-- 5. Why Trust CalcVantage -->
  <section class="about-block">
    <header class="about-block-header">
      <span class="about-eyebrow font-mono">Why trust CalcVantage</span>
      <h2 class="about-block-title">Built to be relied on.</h2>
      <p class="about-block-copy">
        Trust is earned in the details. Here&rsquo;s what we hold ourselves to on every calculator.
      </p>
    </header>

    <div class="trust-grid">
      {
        trustPoints.map((point) => (
          <Card variant="default" padding="lg" rounded="md" class="trust-card">
            <h3 class="trust-title">{point.title}</h3>
            <p class="trust-copy">{point.copy}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- 6. Our Principles -->
  <section class="about-block">
    <header class="about-block-header">
      <span class="about-eyebrow font-mono">Our principles</span>
      <h2 class="about-block-title">Four principles guide every release.</h2>
    </header>

    <div class="principles-grid">
      {
        principles.map((principle, index) => (
          <div class="principle-item">
            <span class="principle-number font-mono">0{index + 1}</span>
            <h3 class="principle-title">{principle.title}</h3>
            <p class="principle-copy">{principle.copy}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 7. Disclaimer -->
  <section class="about-block">
    <div class="disclaimer-panel">
      <span class="about-eyebrow font-mono">Important note</span>
      <h2 class="disclaimer-title">Calculators inform, they don&rsquo;t advise.</h2>
      <p class="disclaimer-copy">
        CalcVantage calculators are provided for educational and informational purposes only. They
        produce estimates based on the information you enter and on current, commonly used
        assumptions — they are not financial, legal, or tax advice, and they do not guarantee any
        particular outcome. Figures may differ from what a lender, insurance provider, or tax
        authority calculates. Before making any significant financial decision, confirm the details
        with a qualified professional.
      </p>
    </div>
  </section>

  <!-- 8. Call-to-Action -->
  <section class="about-cta-band">
    <h2 class="about-cta-title">Ready to run the numbers?</h2>
    <p class="about-cta-copy">
      Pick a calculator and see where your money stands today. No account, no charge — just the
      numbers you need.
    </p>
    <div class="about-hero-actions">
      <ButtonLink href="/mortgage" size="lg" variant="inverse">Start with Mortgage</ButtonLink>
      <ButtonLink href="/retirement" size="lg" variant="inverse-outline">Try Retirement</ButtonLink>
      <ButtonLink href="/net-worth" size="lg" variant="inverse-outline">Check Net Worth</ButtonLink>
    </div>
  </section>
</PageContainer>

<style>
  /* ─── Hero ─── */
  .about-hero {
    text-align: center;
    padding: 3.5rem 0 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .about-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    max-width: 22ch;
  }

  .about-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-body);
    max-width: 42rem;
  }

  .about-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* ─── Editorial Blocks ─── */
  .about-block {
    padding: 3rem 0;
    max-width: 46rem;
    margin: 0 auto;
  }

  .about-block-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .about-block-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .about-block-copy {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-body);
  }

  /* ─── Mission ─── */
  .about-mission {
    padding: 1rem 0;
    max-width: 46rem;
    margin: 0 auto;
  }

  .about-mission-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-left: 3px solid var(--color-accent);
  }

  .about-mission-title {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  /* ─── Offerings ─── */
  .offer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .offer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .offer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .offer-card-link {
    text-decoration: none;
    display: block;
    border-radius: var(--radius-lg);
  }

  .offer-card-link:focus-visible {
    outline: none;
  }

  .offer-card-link:focus-visible .offer-card {
    box-shadow: var(--shadow-focus);
    border-color: var(--color-accent);
  }

  .offer-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .offer-card-link:hover .offer-card {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-md);
  }

  .offer-card-link .offer-cta {
    transition: color var(--transition-fast);
  }

  .offer-card-link:hover .offer-cta {
    color: var(--color-accent-deep);
  }

  .offer-name {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .offer-blurb {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-body);
  }

  .offer-detail {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-mute);
  }

  .offer-cta {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .about-more-tools {
    margin-top: 2rem;
    font-size: 0.9375rem;
  }

  /* ─── Trust Grid ─── */
  .trust-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .trust-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .trust-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .trust-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .trust-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .trust-copy {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-body);
  }

  /* ─── Principles ─── */
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 2.5rem;
    }
  }

  .principle-item {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
  }

  .principle-number {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .principle-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .principle-copy {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-body);
  }

  /* ─── Disclaimer ─── */
  .disclaimer-panel {
    padding: 1.75rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline-strong);
    border-left: 3px solid var(--color-warning);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .disclaimer-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .disclaimer-copy {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-body);
  }

  /* ─── Call-to-Action Band ─── */
  .about-cta-band {
    margin: 2rem 0 1rem;
    padding: 3.5rem 2rem;
    background-color: var(--color-primary);
    border-radius: var(--radius-xl);
    color: var(--color-on-primary);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .about-cta-title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-on-primary);
  }

  .about-cta-copy {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    max-width: 36rem;
  }

  /* ─── Responsive tweaks ─── */
  @media (max-width: 640px) {
    .about-hero {
      padding: 2.5rem 0 2rem;
    }

    .about-block,
    .about-mission {
      padding: 2rem 0;
    }

    .about-hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .about-cta-band {
      padding: 2.5rem 1.25rem;
    }
  }
</style>
