---
import PageContainer from '../components/layout/PageContainer.astro';
import Section from '../components/base/Section.astro';
import CategoryBadge from '../components/blog/CategoryBadge.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import BlogEmptyState from '../components/blog/BlogEmptyState.astro';
import { BLOG_POSTS } from '../data/blog-posts';
import { BLOG_CATEGORIES, getCategoryCount } from '../data/blog-categories';
import type { BlogPost } from '../types/blog';

interface Props {
  posts?: BlogPost[];
}

const { posts = BLOG_POSTS } = Astro.props;

const featuredPost = posts.find((post) => post.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.slug !== featuredPost?.slug).slice(0, 5);
const popularPosts = posts.filter((post) => post.popular).slice(0, 3);
const hasPosts = posts.length > 0;
---

<PageContainer maxWidth="xl">
  <!-- 1. Hero -->
  <section class="blog-hero">
    <span class="pill-badge font-mono">CalcVantage Blog</span>
    <h1 class="blog-title">Financial education, without the jargon.</h1>
    <p class="blog-lead">
      CalcVantage publishes financial education articles, calculator guides, and personal finance
      resources — written to be clear, practical, and useful for the US, Canada, and Australia.
    </p>
  </section>

  <!-- 2. Featured Article -->
  {featuredPost && (
    <section class="blog-section">
      <Section title="Featured Article" subtitle="A hand-picked deep dive from the CalcVantage team.">
        <div class="featured-grid">
          <BlogCard post={featuredPost} featured />
        </div>
      </Section>
    </section>
  )}

  <!-- 3. Categories -->
  <section class="blog-section">
    <Section title="Explore by Category" subtitle="Topics we cover across the CalcVantage library.">
      <div class="categories-grid">
        {BLOG_CATEGORIES.map((category) => {
          const count = hasPosts ? getCategoryCount(posts, category.slug) : 0;
          return (
            <div class="category-chip">
              <CategoryBadge category={category.slug} />
              <span class="category-count">
                {hasPosts && count > 0
                  ? `${count} ${count === 1 ? 'article' : 'articles'}`
                  : 'Coming soon'}
              </span>
            </div>
          );
        })}
      </div>
    </Section>
  </section>

  <!-- 4. Latest Articles -->
  <section class="blog-section">
    <Section title="Latest Articles" subtitle="Fresh from the CalcVantage team.">
      {hasPosts ? (
        <div class="cards-grid latest-grid">
          {latestPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <BlogEmptyState class="blog-empty-block" />
      )}
    </Section>
  </section>

  <!-- 5. Popular Articles -->
  {popularPosts.length > 0 && (
    <section class="blog-section">
      <Section title="Popular Articles" subtitle="Most-read guides from the CalcVantage team.">
        <div class="cards-grid popular-grid">
          {popularPosts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      </Section>
    </section>
  )}
</PageContainer>

<style>
  /* 1. Hero */
  .blog-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .blog-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    max-width: 20ch;
  }

  .blog-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-body);
    max-width: 44rem;
  }


  /* 2–5 shared shells */
  .blog-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 3rem 0;
    align-items: flex-start;
  }

  .blog-section + .blog-section {
    border-top: 1px solid var(--color-hairline);
  }

  .blog-section :global(.section-container) {
    width: 100%;
    margin-top: 0;
    margin-bottom: 0;
  }

  .cards-grid {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  /* 2. Featured */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* 3. Categories */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .category-chip {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.125rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .category-count {
    font-size: 0.8125rem;
    color: var(--color-mute);
  }

  /* 4. Latest */
  .latest-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .latest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .latest-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 5. Popular */
  .popular-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .popular-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }


  @media (max-width: 640px) {
    .blog-hero {
      padding: 2.5rem 0 2rem;
    }

    .blog-section {
      padding: 2rem 0;
    }
  }
</style>