---
import PageContainer from '../components/layout/PageContainer.astro';
import CategoryBadge from '../components/blog/CategoryBadge.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import BlogEmptyState from '../components/blog/BlogEmptyState.astro';
import { BLOG_POSTS } from '../data/blog-posts';
import { BLOG_CATEGORIES, getCategoryCount } from '../data/blog-categories';
import type { BlogPost } from '../types/blog';

interface Props {
  posts?: BlogPost[];
}

const { posts = BLOG_POSTS } = Astro.props;

const featuredPost = posts.find((post) => post.featured) ?? posts[0];
const latestPosts = posts.filter((post) => post.slug !== featuredPost?.slug).slice(0, 5);
const popularPosts = posts.filter((post) => post.popular).slice(0, 3);
const hasPosts = posts.length > 0;
---

<PageContainer maxWidth="xl">
  <!-- 1. Hero -->
  <section class="blog-hero">
    <span class="blog-badge font-mono">CalcVantage Blog</span>
    <h1 class="blog-title">Financial education, without the jargon.</h1>
    <p class="blog-lead">
      CalcVantage publishes financial education articles, calculator guides, and personal finance
      resources — written to be clear, practical, and useful for the US, Canada, and Australia.
    </p>
  </section>

  <!-- 2. Featured Article -->
  {featuredPost && (
    <section class="blog-section">
      <header class="section-header">
        <h2 class="section-title text-display-md">Featured Article</h2>
        <p class="section-subtitle text-body-sm">A hand-picked deep dive from the CalcVantage team.</p>
      </header>
      <div class="featured-grid">
        <BlogCard post={featuredPost} featured class="featured-spotlight" />
      </div>
    </section>
  )}

  <!-- 3. Categories -->
  <section class="blog-section">
    <header class="section-header">
      <h2 class="section-title text-display-md">Explore by Category</h2>
      <p class="section-subtitle text-body-sm">Topics we cover across the CalcVantage library.</p>
    </header>
    <div class="categories-grid">
      {BLOG_CATEGORIES.map((category) => (
        <div class="category-chip">
          <CategoryBadge category={category.slug} />
          <span class="category-count">
            {hasPosts ? `${getCategoryCount(posts, category.slug)} article(s)` : 'Coming soon'}
          </span>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. Latest Articles -->
  <section class="blog-section">
    <header class="section-header">
      <h2 class="section-title text-display-md">Latest Articles</h2>
      <p class="section-subtitle text-body-sm">Fresh from the CalcVantage team.</p>
    </header>
    {hasPosts ? (
      <div class="cards-grid latest-grid">
        {latestPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <BlogEmptyState class="blog-empty-block" />
    )}
  </section>

  <!-- 5. Popular Articles -->
  {popularPosts.length > 0 && (
    <section class="blog-section">
      <header class="section-header">
        <h2 class="section-title text-display-md">Popular Articles</h2>
        <p class="section-subtitle text-body-sm">Most-read guides from the CalcVantage team.</p>
      </header>
      <div class="cards-grid popular-grid">
        {popularPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </section>
  )}

  <!-- 6. Newsletter CTA -->
  <section class="newsletter-section">
    <div class="newsletter-card">
      <div class="newsletter-copy">
        <span class="blog-badge font-mono">Stay in the loop</span>
        <h2 class="newsletter-title">Get the latest articles and calculator guides</h2>
        <p class="newsletter-text">
          New financial education content, delivered straight to your inbox. No spam — just clear,
          useful reading.
        </p>
      </div>
      <form class="newsletter-form" onsubmit="return false">
        <label class="visually-hidden" for="newsletter-email">Email address</label>
        <input
          class="newsletter-input"
          id="newsletter-email"
          name="email"
          type="email"
          placeholder="you@example.com"
          autocomplete="email"
        />
        <button class="newsletter-button" type="submit">Subscribe</button>
      </form>
    </div>
  </section>
</PageContainer>

<style>
  /* 1. Hero */
  .blog-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .blog-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-body);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }

  .blog-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
    max-width: 20ch;
  }

  .blog-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-body);
    max-width: 44rem;
  }

  /* Email input */
  .newsletter-input {
    flex: 1;
    min-height: 3rem;
    padding: 0 1.25rem;
    font-size: 1rem;
    font-family: var(--font-sans);
    color: var(--color-ink);
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline-strong);
    border-radius: var(--radius-pill);
    outline: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .newsletter-input::placeholder {
    color: var(--color-mute);
  }

  .newsletter-input:focus {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-focus);
  }

  /* 2–5 shared shells */
  .blog-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 3rem 0;
  }

  .blog-section + .blog-section {
    border-top: 1px solid var(--color-hairline);
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .section-title {
    color: var(--color-ink);
  }

  .section-subtitle {
    color: var(--color-body);
  }

  .cards-grid {
    display: grid;
    gap: 1.5rem;
    width: 100%;
  }

  /* 2. Featured */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  /* 3. Categories */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .category-chip {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.125rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .category-count {
    font-size: 0.8125rem;
    color: var(--color-mute);
  }

  /* 4. Latest */
  .latest-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .latest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .latest-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 5. Popular */
  .popular-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .popular-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* 6. Newsletter */
  .newsletter-section {
    padding: 2rem 0 1rem;
  }

  .newsletter-card {
    display: block;
    background-color: var(--color-primary);
    border-radius: var(--radius-xl);
    padding: 3rem 2rem;
    color: var(--color-on-primary);
  }

  .newsletter-copy {
    display: block;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .newsletter-copy .blog-badge {
    color: var(--color-on-primary);
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .newsletter-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-on-primary);
    max-width: 30ch;
    margin: 0 auto 0.5rem;
  }

  .newsletter-text {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    max-width: 32rem;
    margin: 0 auto;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 34rem;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .newsletter-form {
      flex-direction: row;
    }
  }

  .newsletter-input {
    flex: 1;
    min-width: 0;
    color: var(--color-ink);
    background-color: var(--color-canvas);
    border-color: transparent;
  }

  .newsletter-button {
    flex-shrink: 0;
    height: 3rem;
    padding: 0 1.75rem;
    font-size: 1rem;
    font-weight: 500;
    font-family: var(--font-sans);
    color: var(--color-ink);
    background-color: var(--color-on-primary);
    border: none;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .newsletter-button:hover {
    background-color: #ececec;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .blog-hero {
      padding: 2.5rem 0 2rem;
    }

    .blog-section {
      padding: 2rem 0;
    }

    .newsletter-card {
      padding: 2rem 1.25rem;
    }
  }
</style>