---
import PageContainer from '../components/layout/PageContainer.astro';
import Card from '../components/base/Card.astro';

const contactEmail = 'hello@calcvantage.com';

const responseTimes = [
  {
    title: 'Calculator feedback & corrections',
    copy: 'Flag an issue, a wrong assumption, or a result that looks off. We act on these quickly.',
    time: 'Usually same day',
  },
  {
    title: 'Financial questions',
    copy: 'Ask us about how a calculation works or what a result means for your situation.',
    time: '1–2 business days',
  },
  {
    title: 'Partnerships & press',
    copy: 'Media inquiries, collaborations, and integration requests from organizations.',
    time: '2–5 business days',
  },
];

const quickLinks = [
  {
    label: 'Frequently asked questions',
    href: '/faq',
    copy: 'Common answers about calculators, assumptions, and how the math works.',
  },
  {
    label: 'About CalcVantage',
    href: '/about',
    copy: 'Who we are, what we build, and the principles behind every tool.',
  },
];
---

<PageContainer maxWidth="xl">
  <!-- 1. Hero -->
  <section class="contact-hero">
    <div class="contact-hero-text">
      <span class="pill-badge font-mono">Contact Us</span>
      <h1 class="contact-title">
        Questions, feedback, or an idea — Let&rsquo;s talk.
      </h1>
      <p class="contact-lead">
        CalcVantage is built on the input of the people who use it. Whether you spotted a result
        that looks wrong, want a calculator you don&rsquo;t see yet, or just have a question —
        we&rsquo;d love to hear from you.
      </p>
    </div>
    <div class="contact-hero-card contact-info-card">
      <span class="contact-eyebrow font-mono">Direct email</span>
      <a class="contact-email" href={`mailto:${contactEmail}`}>{contactEmail}</a>
      <p class="contact-info-copy">
        Prefer email? Write to us directly and we&rsquo;ll get back to you.
      </p>
    </div>
  </section>

  <!-- 2. Intro -->
  <section class="contact-intro">
    <p class="contact-intro-copy">
      Tell us what brought you here and we&rsquo;ll point you in the right direction. Every message
      is read by a real person, and we reply to everything we receive.
    </p>
  </section>

  <!-- 3. Contact info -->
  <section class="contact-grid">
    <div class="contact-info-col">
      <div class="contact-info-card">
        <span class="contact-eyebrow font-mono">Quick links</span>
        <div class="contact-quick-links">
          {quickLinks.map((link) => (
            <a class="contact-quick-link" href={link.href}>
              <span class="contact-quick-title">{link.label} →</span>
              <span class="contact-quick-copy">{link.copy}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Response time -->
  <section class="contact-response-section">
    <header class="contact-section-header">
      <span class="contact-eyebrow font-mono">Our response time</span>
      <h2 class="contact-section-title">When you&rsquo;ll hear back</h2>
      <p class="contact-section-copy">
        We reply to everything. How quickly depends on what you&rsquo;re asking.
      </p>
    </header>
    <div class="contact-response-grid">
      {
        responseTimes.map((item) => (
          <Card variant="default" padding="lg" rounded="md" class="contact-response-card">
            <p class="contact-response-time">{item.time}</p>
            <h3 class="contact-response-title">{item.title}</h3>
            <p class="contact-response-copy">{item.copy}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- 5. Trust message -->
  <section class="contact-trust">
    <div class="contact-trust-card">
      <span class="contact-trust-badge font-mono">A note on trust</span>
      <h2 class="contact-trust-title">Free. Private. On your machine.</h2>
      <p class="contact-trust-copy">
        Every calculator runs locally in your browser — the numbers you enter never leave your
        device and are never stored. No accounts, no sign-ups, no selling your information. If you
        ever send us a message, it&rsquo;s used only to reply to you.
      </p>
    </div>
  </section>
</PageContainer>

<style>
  /* ─── Hero ─── */
  .contact-hero {
    padding: 3.5rem 0 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .contact-hero {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2.5rem;
    }
  }

  .contact-hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }

  .contact-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-body);
    margin: 0;
  }

  /* ─── Intro ─── */
  .contact-intro {
    padding: 1rem 0 2rem;
    max-width: 48rem;
  }

  .contact-intro-copy {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-body);
    margin: 0;
  }

  /* ─── Contact info ─── */
  .contact-grid {
    padding-bottom: 1rem;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 32rem;
  }

  .contact-info-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .contact-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .contact-email {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    word-break: break-all;
    transition: color var(--transition-fast);
  }

  .contact-email:hover {
    color: var(--color-accent-deep);
    text-decoration: underline;
  }

  .contact-info-copy {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-body);
    margin: 0;
  }

  .contact-quick-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .contact-quick-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    background-color: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .contact-quick-link:hover {
    border-color: var(--color-hairline-strong);
    box-shadow: var(--shadow-md);
  }

  .contact-quick-link:focus-visible {
    outline: none;
    box-shadow: var(--shadow-focus);
    border-color: var(--color-accent);
  }

  .contact-quick-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .contact-quick-copy {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-body);
    margin: 0;
  }

  /* ─── Response time section ─── */
  .contact-response-section {
    padding: 3rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-section-header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 46rem;
  }

  .contact-section-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .contact-section-copy {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-body);
    margin: 0;
  }

  .contact-response-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .contact-response-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .contact-response-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-response-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
  }

  .contact-response-time {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.01em;
    font-family: var(--font-mono);
  }

  .contact-response-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .contact-response-copy {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-body);
    margin: 0;
  }

  /* ─── Trust band ─── */
  .contact-trust {
    padding: 2rem 0 1rem;
  }

  .contact-trust-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 3rem 2rem;
    background-color: var(--color-primary);
    border-radius: var(--radius-xl);
    color: var(--color-on-primary);
  }

  .contact-trust-badge {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .contact-trust-title {
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-on-primary);
  }

  .contact-trust-copy {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
    max-width: 40rem;
    margin: 0;
  }

  /* ─── Responsive ─── */
  @media (max-width: 640px) {
    .contact-hero {
      padding: 2.5rem 0 1rem;
    }

    .contact-intro {
      padding: 1rem 0 1.5rem;
    }

    .contact-response-section {
      padding: 2.5rem 0 1.5rem;
    }

    .contact-trust-card {
      padding: 2rem 1.25rem;
    }
  }
</style>